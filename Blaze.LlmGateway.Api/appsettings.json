{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Hosting": "Debug",
      "Microsoft.AspNetCore.Routing": "Debug",
      "System.Net.Http": "Debug",
      "Blaze.LlmGateway": "Debug",
      "Blaze.LlmGateway.Infrastructure": "Debug",
      "Blaze.LlmGateway.LocalInference": "Debug",
      "Microsoft.Extensions.AI": "Debug",
      "Polly": "Debug"
    }
  },
  "AllowedHosts": "*",
  "LlmGateway": {
    "VerboseRouteLogging": true,
    "OfflineOnly": false,
    "AllowInvalidProviderCertificates": false,
    "ProtocolStore": {
      "Provider": "sqlite",
      "Path": "App_Data/protocol-store.sqlite3"
    },
    "Auth": {
      "RequestsPerMinutePerKey": 60,
      "RequestsPerMinutePerIp": 30,
      "HealthCheckKey": "sk-blaze-healthcheck"
    },
    "RateLimits": {},
    "OutputSavers": {
      "Caveman":  { "Enabled": false, "Level": "Full" },
      "Ponytail": { "Enabled": false, "Level": "Full" }
    },
    "ToolOutputCompression": {
      "Enabled": true,
      "MinLengthChars": 2000,
      "MaxLengthChars": 24000
    },
    "LocalInference": {
      "Enabled": true,
      "ModelPath": "https://huggingface.co/lm-kit/gemma-4-e4b-instruct-lmk/resolve/main/Gemma-4-E4B-It-7.5B-Q4_K_M.lmk",
      "ModelTiers": [
        { "Name": "gemma-4-2b",  "MinTotalMemoryGb": 0,  "ModelPath": "https://huggingface.co/lm-kit/gemma-4-e2b-instruct-lmk/resolve/main/Gemma-4-E2B-It-4.6B-Q4_K_M.lmk" },
        { "Name": "gemma-4-4b",  "MinTotalMemoryGb": 12, "ModelPath": "https://huggingface.co/lm-kit/gemma-4-e4b-instruct-lmk/resolve/main/Gemma-4-E4B-It-7.5B-Q4_K_M.lmk" },
        { "Name": "gemma-4-12b", "MinTotalMemoryGb": 24, "ModelPath": "https://huggingface.co/lm-kit/gemma-4-12b-instruct-lmk/resolve/main/gemma-4-12B-it-Q4_K_M.lmk" }
      ],
      "CacheDirectory": ".llm-cache",
      "DownloadTimeoutSeconds": 3600,
      "EnableChecksumValidation": false,
      "ThreadCount": 0,
      "MaxContextTokens": 4096,
      "Temperature": 0.7,
      "TopP": 0.9,
      "SystemPrompt": "You are CodebrewRouter, a concise coding assistant for OpenCode. Answer the user's latest request directly. Do not recap the session, mention recent activity, offer menu options, or invent context. For greetings, reply with one short sentence. Do not reveal chain-of-thought, planning notes, scratchpad text, hidden reasoning, or a thinking process. If you need to reason, do it silently and provide only the final useful answer.",
      "WarmupEnabled": true,
      "WarmupPrompt": "ready",
      "WarmupMaxOutputTokens": 1,
      "WarmupTimeoutSeconds": 120,
      "BlockStartupUntilWarm": true
    },
    "Providers": {
      "OpenCodeGo": {
        "BaseUrl": "https://opencode.ai/zen/go/v1",
        "ApiKey": "",
        "MaxContextTokens": 128000,
        "ReservedOutputTokens": 16384
      }
    },
    "Routing": {
      "RouterModel": "router",
      "FallbackDestination": "LocalGemma",
      "FailoverChains": {}
    },
    "CodebrewRouter": {
      "Enabled": true,
      "ModelId": "codebrewRouter",
      "FallbackRules": {
        "Reasoning":             ["OpenCodeGo_MiMoV2Omni", "LocalGemma"],
        "Coding":                ["OpenCodeGo_MiMoV2Omni", "LocalGemma"],
        "Research":              ["OpenCodeGo_MiMoV2Omni", "LocalGemma"],
        "VisionObjectDetection": ["OpenCodeGo_MiMoV2Omni", "LocalGemma"],
        "Speech":                ["OpenCodeGo_MiMoV2Omni", "LocalGemma"],
        "Creative":              ["OpenCodeGo_MiMoV2Omni", "LocalGemma"],
        "DataAnalysis":          ["OpenCodeGo_MiMoV2Omni", "LocalGemma"],
        "General":               ["OpenCodeGo_MiMoV2Omni", "LocalGemma"]
      },
      "ContextCompaction": {
        "Enabled": true,
        "TargetBudgetRatio": 0.85,
        "MinMessagesToCompact": 6,
        "PreserveMostRecentMessages": 4,
        "SummaryMaxOutputTokens": 256,
        "SummaryTemperature": 0.0
      }
    },
    "Fusion": {
      "Enabled": true,
      "MaxProposers": 3,
      "MinProposers": 2,
      "ProposerTimeoutSeconds": 30,
      "StragglerGraceSeconds": 6,
      "ProposerTemperature": 0.7,
      "AggregatorTemperature": 0.4,
      "ProposerMaxOutputTokens": 1536,
      "MaxReferenceChars": 8000,
      "ProposerSetsByTaskClass": {
        "Reasoning":             ["OpenCodeGo_KimiK2_6", "OpenCodeGo_DeepSeekV4Pro", "OpenCodeGo_KimiK2_5"],
        "Coding":                ["OpenCodeGo_DeepSeekV4Pro", "OpenCodeGo_Qwen3_6Plus", "OpenCodeGo_MiniMaxM2_7"],
        "Research":              ["OpenCodeGo_KimiK2_6", "OpenCodeGo_GLM5_1", "OpenCodeGo_MiMoV2_5"],
        "VisionObjectDetection": ["OpenCodeGo_MiMoV2Omni", "OpenCodeGo_GLM5_1", "OpenCodeGo_MiMoV2_5"],
        "Speech":                ["OpenCodeGo_MiMoV2Omni", "OpenCodeGo_GLM5_1", "OpenCodeGo_DeepSeekV4Flash"],
        "Creative":              ["OpenCodeGo_GLM5_1", "OpenCodeGo_MiMoV2_5", "OpenCodeGo_GLM5"],
        "DataAnalysis":          ["OpenCodeGo_DeepSeekV4Pro", "OpenCodeGo_Qwen3_6Plus", "OpenCodeGo_MiniMaxM2_7"],
        "General":               ["OpenCodeGo_Qwen3_6Plus", "OpenCodeGo_MiniMaxM2_5", "OpenCodeGo_DeepSeekV4Flash"]
      },
      "AggregatorByTaskClass": {
        "Reasoning":             ["OpenCodeGo_KimiK2_6", "OpenCodeGo_DeepSeekV4Pro"],
        "Coding":                ["OpenCodeGo_DeepSeekV4Pro", "OpenCodeGo_KimiK2_6"],
        "Research":              ["OpenCodeGo_KimiK2_6", "OpenCodeGo_GLM5_1"],
        "VisionObjectDetection": ["OpenCodeGo_MiMoV2Omni", "OpenCodeGo_GLM5_1"],
        "Speech":                ["OpenCodeGo_MiMoV2Omni", "OpenCodeGo_GLM5_1"],
        "Creative":              ["OpenCodeGo_GLM5_1", "OpenCodeGo_MiMoV2_5"],
        "DataAnalysis":          ["OpenCodeGo_DeepSeekV4Pro", "OpenCodeGo_KimiK2_6"],
        "General":               ["OpenCodeGo_DeepSeekV4Pro", "OpenCodeGo_Qwen3_6Plus"]
      }
    },
    "VirtualModels": {
      "auto": {
        "Enabled": true,
        "ModelId": "auto",
        "Provider": "CodebrewRouter",
        "OwnedBy": "nous-research",
        "Source": "virtual",
        "Capabilities": ["chat", "tools", "streaming", "auto-route"],
        "ToolSupport": true,
        "VisionSupport": false,
        "CloudRequired": false,
        "ContextWindow": 128000,
        "FallbackRules": {
          "Reasoning":             ["OpenCodeGo_MiMoV2Omni", "LocalGemma"],
          "Coding":                ["OpenCodeGo_MiMoV2Omni", "LocalGemma"],
          "Research":              ["OpenCodeGo_MiMoV2Omni", "LocalGemma"],
          "VisionObjectDetection": ["OpenCodeGo_MiMoV2Omni", "LocalGemma"],
          "Creative":              ["OpenCodeGo_MiMoV2Omni", "LocalGemma"],
          "DataAnalysis":          ["OpenCodeGo_MiMoV2Omni", "LocalGemma"],
          "General":               ["OpenCodeGo_MiMoV2Omni", "LocalGemma"]
        }
      }
    },
    "Availability": {
      "Enabled": false
    },
    "PromptCleanup": {
      "Enabled": true,
      "MaxOutputTokens": 256,
      "Temperature": 0.0,
      "MinLengthChars": 80,
      "CooldownMinutes": 5
    },
    "TaskClassification": {
      "Enabled": true,
      "MaxOutputTokens": 50,
      "Temperature": 0.0,
      "CooldownMinutes": 5
    },
    "ProviderCatalog": {
      "DefaultRoutingStrategy": "round_robin",
      "DefaultFallbackStrategy": "failover",
      "HealthCheckIntervalSeconds": 30,
      "UnhealthyThreshold": 3,
      "RecoveryIntervalSeconds": 30,
      "Deployments": [
        {
          "Name": "local-gemma",
          "ModelName": "gemma-local",
          "Provider": "LocalGemma",
          "Endpoint": "",
          "ApiKey": "",
          "Model": "",
          "Weight": 1,
          "Priority": 10,
          "MaxContextTokens": 4096,
          "Capabilities": ["chat"],
          "CostPerToken": 0,
          "Tags": ["local", "offline"],
          "Enabled": true
        }
      ],
      "ModelRouting": {
        "gemma-local": {
          "Strategy": "round_robin",
          "Deployments": ["local-gemma"],
          "Fallbacks": []
        },
        "auto": {
          "Strategy": "round_robin",
          "Deployments": ["local-gemma"],
          "Fallbacks": []
        }
      }
    }
  }
}
